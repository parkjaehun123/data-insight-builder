# Gemini API 설정
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Flask 서버 설정
FLASK_DEBUG=true
MAX_UPLOAD_MB=10

# 앱 접속 비밀번호 및 세션 암호화 키 설정
# Vercel 배포 시 Environment Variables에 APP_PASSWORD를 등록하면 해당 비밀번호로 보호됩니다.
APP_PASSWORD=your_password_here
SECRET_KEY=your_secret_session_key_here
